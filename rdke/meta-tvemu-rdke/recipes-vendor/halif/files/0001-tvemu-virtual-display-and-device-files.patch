+#include <stdint.h>
+
+/* tv-emu: handles that have been through 32 bits.
+ *
+ * A handle of this library is the address of one of its own tables. RDK's
+ * device settings plug-in keeps handles in an int32_t (its interface,
+ * Exchange::IDeviceSettings..., is defined so), which is the whole handle on
+ * 32-bit ARM. On a 64-bit machine the upper half is lost, and the handle
+ * comes back with that half all zeros or all ones. The lower half is intact,
+ * and the upper half is that of the table the handle points into: it is put
+ * back here. A handle that still has its upper half is returned as it is.
+ */
+static inline intptr_t dsHalWidenHandle(intptr_t handle, const void *table)
+{
+	uintptr_t value = (uintptr_t)handle;
+	uintptr_t anchor = (uintptr_t)table;
+	uintptr_t upper = value >> 32;
+	uintptr_t wide;
+
+	if (sizeof(intptr_t) <= 4 || value == 0 || (upper != 0 && upper != 0xffffffffu)) {
+		return handle;
+	}
+	wide = (anchor & ~(uintptr_t)0xffffffffu) | (value & 0xffffffffu);
+	/* The table may lie across a 4 GB boundary from where the handle points. */
+	if (wide > anchor && wide - anchor > 0x80000000u) {
+		wide -= (uintptr_t)1 << 32;
+	} else if (anchor > wide && anchor - wide > 0x80000000u) {
+		wide += (uintptr_t)1 << 32;
+	}
+	return (intptr_t)wide;
+}
+
 #endif
