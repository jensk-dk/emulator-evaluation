[Unit]
Description=Westeros' test client, which draws with OpenGL ES (westeros_test)
After=tvemu-westeros.service
Requires=tvemu-westeros.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/tvemu-wayland
# The compositor's socket is there a moment after it starts.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/tvemu-wayland/wayland-0 ] && exit 0; sleep 0.1; done; exit 1'
# With --shell: without it the client has no handle on Westeros' shell
# interface and still uses it when an arrow key arrives, which ends it with
# a segmentation fault (westeros-test.cpp, drawFrame). With it the arrow keys
# move the client's surface, which is what they are for in this tool.
ExecStart=/usr/bin/westeros_test --shell --display wayland-0
Restart=no

[Install]
WantedBy=multi-user.target
